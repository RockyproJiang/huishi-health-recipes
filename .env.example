# 慧食图谱 · 生产环境变量
# 复制为 .env 后按实际修改；不要提交到 git
#
# 用法（systemd）：EnvironmentFile=/opt/huishi/.env
# 用法（手工）：set -a; source .env; set +a

# ===== 必改 =====
# Flask session 签名密钥，生产环境必须换成随机值：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME_use_a_random_64_hex_string

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=huishi
DB_PASSWORD=CHANGE_ME
DB_NAME=diet_platform

# ===== AI（DeepSeek）=====
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 其他 =====
# 生产环境关闭调试
FLASK_DEBUG=0
